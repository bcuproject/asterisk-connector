# Public hostname for HTTPS (point a DNS A record at the machine running docker compose)
DOMAIN=pbx-connector.example.com

# Secret part of the connector URL: https://$DOMAIN/mcp/<CONNECTOR_TOKEN>
# Generate with: openssl rand -hex 32
CONNECTOR_TOKEN=

# "ssh" (connector on another machine) or "local" (connector installed on the Asterisk server itself)
RUN_MODE=ssh

# SSH to the Asterisk server
ASTERISK_SSH_HOST=203.0.113.10
ASTERISK_SSH_PORT=22
ASTERISK_SSH_USER=claude-mcp
ASTERISK_SSH_KEY=/keys/id_ed25519
ASTERISK_SSH_KEY_PASSPHRASE=
# Printed by setup/asterisk-server-setup.sh (or: ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub on the server)
ASTERISK_HOST_FINGERPRINT=SHA256:

# On the Asterisk server
ASTERISK_CMD=sudo -n /usr/sbin/asterisk
ASTERISK_CONF_DIR=/etc/asterisk
ASTERISK_LOG_DIR=/var/log/asterisk

# Set to false for a read-only connector
ALLOW_WRITE=true
